---
// Small stroke icons, 24x24, Lucide-style. Kept inline so there is no icon dependency.
interface Props {
  name: keyof typeof icons;
  class?: string;
  size?: number;
}

const icons = {
  layers: '<path d="M12 3 2 8l10 5 10-5-10-5ZM2 13l10 5 10-5M2 18l10 5 10-5"/>',
  tree: '<rect x="3" y="3" width="7" height="5" rx="1.5"/><rect x="14" y="10" width="7" height="5" rx="1.5"/><rect x="14" y="17" width="7" height="5" rx="1.5"/><path d="M6.500 8v11.500H14M6.500 12.500H14"/>',
  cursor: '<path d="M5 3l14 7-6 2-2 6L5 3z"/>',
  eye: '<path d="M2 12s3.600-7 10-7 10 7 10 7-3.600 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/>',
  snow: '<path d="M12 2v20M3.300 7l17.400 10M20.700 7 3.300 17"/><path d="M9.500 3.500 12 6l2.500-2.500M9.500 20.500 12 18l2.500 2.500"/>',
  lock: '<rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/>',
  search: '<circle cx="11" cy="11" r="7"/><path d="m20 20-3.500-3.500"/>',
  palette: '<path d="M12 3a9 9 0 1 0 0 18c1.400 0 2-.900 2-2 0-1.700 1-2.500 2.500-2.500H18a3 3 0 0 0 3-3C21 7.500 17 3 12 3Z"/><circle cx="7.500" cy="11" r="1"/><circle cx="10.500" cy="7.500" r="1"/><circle cx="15" cy="8" r="1"/>',
  focus: '<circle cx="12" cy="12" r="3"/><path d="M4 8V5a1 1 0 0 1 1-1h3M16 4h3a1 1 0 0 1 1 1v3M20 16v3a1 1 0 0 1-1 1h-3M8 20H5a1 1 0 0 1-1-1v-3"/>',
  moveIn: '<path d="M4 12h11M11 7l5 5-5 5"/><path d="M20 4v16"/>',
  refresh: '<path d="M20 11a8 8 0 0 0-14.300-4.300L4 8.500"/><path d="M4 4v4.500h4.500"/><path d="M4 13a8 8 0 0 0 14.300 4.300L20 15.500"/><path d="M20 20v-4.500h-4.500"/>',
  undo: '<path d="M9 14 4 9l5-5"/><path d="M4 9h10a6 6 0 0 1 0 12h-3"/>',
  zap: '<path d="M13 2 4 14h7l-1 8 9-12h-7l1-8Z"/>',
  minimize: '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 9h18"/>',
  code: '<path d="m8 8-4 4 4 4M16 8l4 4-4 4M13.500 5l-3 14"/>',
  download: '<path d="M12 3v12m-5-5 5 5 5-5M4 21h16"/>',
  check: '<path d="m5 12 5 5L20 7"/>',
  sun: '<circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.900 4.900l1.400 1.400m11.400 11.400 1.400 1.400M2 12h2m16 0h2M4.900 19.100l1.400-1.400m11.400-11.400 1.400-1.400"/>',
  moon: '<path d="M21 12.800A9 9 0 1 1 11.200 3a7 7 0 0 0 9.800 9.800Z"/>',
  github: '<path fill="currentColor" stroke="none" d="M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.600-4-1.600-.6-1.400-1.400-1.800-1.400-1.800-1-.7.1-.7.1-.7 1.200 0 1.900 1.200 1.900 1.200 1 1.800 2.800 1.300 3.500 1 0-.8.4-1.300.7-1.600-2.700-.3-5.500-1.300-5.500-6 0-1.200.5-2.300 1.300-3.100-.2-.4-.6-1.600 0-3.200 0 0 1-.3 3.400 1.200a11.500 11.500 0 0 1 6 0c2.300-1.500 3.300-1.200 3.300-1.200.6 1.600.2 2.800 0 3.200.9.800 1.300 1.900 1.300 3.100 0 4.600-2.800 5.600-5.500 5.900.5.4.9 1 .9 2.200v3.300c0 .3.1.7.8.6A12 12 0 0 0 12 .3"/>',
};

const { name, class: className = '', size = 24 } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  class={className}
  set:html={icons[name]}
/>
