---
// A carousel of panel states. Every slide is a real render of the panel made
// inside 3ds Max (LayerManager/tools/make_shots.ps1); demo.json lists the slides
// and their captions. The panel follows the site theme, like it follows the
// 3ds Max theme. Slides advance on their own and can be dragged left / right.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import manifest from '../assets/demo/demo.json';

const files = import.meta.glob<{ default: ImageMetadata }>('../assets/demo/*.png', { eager: true });
const image = (name: string) => files[`../assets/demo/${name}`].default;

const { width, height } = manifest;
const slides = manifest.themes.dark.map((frame, i) => ({
  caption: frame.caption,
  dark: image(frame.image),
  light: image(manifest.themes.light[i].image),
}));
---

<figure
  class="demo mx-auto w-full max-w-[380px]"
  data-captions={JSON.stringify(slides.map((s) => s.caption))}
  role="group"
  aria-roledescription="carousel"
  aria-label="Layer Manager panel in different states"
>
  <div
    class="demo-viewport relative cursor-grab touch-pan-y overflow-hidden rounded-2xl ring-1 ring-black/10 select-none shadow-[0_40px_80px_-30px_rgba(0,0,0,0.45)] dark:ring-white/10 dark:shadow-[0_40px_80px_-30px_rgba(0,0,0,0.9)]"
    style={`aspect-ratio: ${width} / ${height}`}
    tabindex="0"
  >
    <div class="demo-track flex h-full">
      {slides.map((slide, i) => (
        <div class="relative h-full w-full shrink-0" aria-hidden={i === 0 ? 'false' : 'true'} data-slide={i}>
          <Image src={slide.dark} alt={slide.caption} width={width * 2} loading="eager" draggable="false" class="hidden size-full dark:block" />
          <Image src={slide.light} alt={slide.caption} width={width * 2} loading="eager" draggable="false" class="size-full dark:hidden" />
        </div>
      ))}
    </div>
  </div>

  <figcaption class="mt-5 text-center">
    <p class="demo-caption min-h-[1.5rem] text-sm font-medium text-ink-muted dark:text-ink-muted-dark" aria-live="polite">{slides[0].caption}</p>
    <div class="mt-3 flex justify-center gap-1.5">
      {slides.map((slide, i) => (
        <button
          type="button"
          data-dot={i}
          aria-label={`Slide ${i + 1}: ${slide.caption}`}
          class:list={['demo-dot h-1.5 w-1.5 cursor-pointer rounded-full bg-line dark:bg-line-dark', i === 0 && 'is-on']}
        ></button>
      ))}
    </div>
  </figcaption>
</figure>

<script>
  const INTERVAL = 3500; // ms a slide stays before the next one swipes in
  const THRESHOLD = 0.18; // share of the width a drag must cover to change slide

  document.querySelectorAll<HTMLElement>('.demo').forEach((root) => {
    const captions: string[] = JSON.parse(root.dataset.captions ?? '[]');
    const viewport = root.querySelector<HTMLElement>('.demo-viewport')!;
    const track = root.querySelector<HTMLElement>('.demo-track')!;
    const slides = root.querySelectorAll<HTMLElement>('[data-slide]');
    const dots = root.querySelectorAll<HTMLElement>('[data-dot]');
    const caption = root.querySelector<HTMLElement>('.demo-caption')!;
    const count = captions.length;

    let index = 0;
    let timer = 0;
    let visible = false;
    let hovered = false;
    let drag: { id: number; startX: number; dx: number } | null = null;

    const place = (offsetPx = 0) => {
      track.style.transform = `translateX(calc(${-index * 100}% + ${offsetPx}px))`;
    };

    const go = (next: number) => {
      index = (next + count) % count;
      track.classList.remove('is-dragging');
      place();
      dots.forEach((d) => d.classList.toggle('is-on', Number(d.dataset.dot) === index));
      slides.forEach((s) => s.setAttribute('aria-hidden', String(Number(s.dataset.slide) !== index)));
      caption.textContent = captions[index];
    };

    const stop = () => {
      clearInterval(timer);
      timer = 0;
    };

    // Autoplay runs while the carousel is on screen and nobody is holding or hovering it.
    const schedule = () => {
      stop();
      if (visible && !hovered && !drag) timer = window.setInterval(() => go(index + 1), INTERVAL);
    };

    dots.forEach((dot) =>
      dot.addEventListener('click', () => {
        go(Number(dot.dataset.dot));
        schedule();
      }),
    );

    // Swipe with the mouse, a finger or a pen.
    viewport.addEventListener('pointerdown', (event) => {
      if (event.pointerType === 'mouse' && event.button !== 0) return;
      drag = { id: event.pointerId, startX: event.clientX, dx: 0 };
      viewport.setPointerCapture(event.pointerId);
      track.classList.add('is-dragging');
      viewport.classList.add('cursor-grabbing');
      stop();
    });

    viewport.addEventListener('pointermove', (event) => {
      if (!drag || event.pointerId !== drag.id) return;
      drag.dx = event.clientX - drag.startX;
      // Resist at the two ends, where there is nothing to reveal.
      const atEdge = (index === 0 && drag.dx > 0) || (index === count - 1 && drag.dx < 0);
      place(atEdge ? drag.dx / 3 : drag.dx);
    });

    const release = (event: PointerEvent) => {
      if (!drag || event.pointerId !== drag.id) return;
      const moved = drag.dx / viewport.clientWidth;
      drag = null;
      viewport.classList.remove('cursor-grabbing');
      if (moved <= -THRESHOLD && index < count - 1) go(index + 1);
      else if (moved >= THRESHOLD && index > 0) go(index - 1);
      else go(index);
      schedule();
    };
    viewport.addEventListener('pointerup', release);
    viewport.addEventListener('pointercancel', release);

    viewport.addEventListener('keydown', (event) => {
      if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
      event.preventDefault();
      go(index + (event.key === 'ArrowRight' ? 1 : -1));
      schedule();
    });

    root.addEventListener('mouseenter', () => {
      hovered = true;
      schedule();
    });
    root.addEventListener('mouseleave', () => {
      hovered = false;
      schedule();
    });

    new IntersectionObserver(
      (entries) => {
        visible = entries[entries.length - 1].isIntersecting;
        schedule();
      },
      { threshold: 0.3 },
    ).observe(root);
  });
</script>
