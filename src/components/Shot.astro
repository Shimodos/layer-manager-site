---
// A render of the panel in a soft frame.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  width: number;
  class?: string;
  loading?: 'lazy' | 'eager';
}

const { src, alt, width, class: className = '', loading = 'lazy' } = Astro.props;
---

<Image
  src={src}
  alt={alt}
  width={width * 2}
  loading={loading}
  style={`width: ${width}px`}
  class:list={[
    'h-auto max-w-full rounded-2xl ring-1 ring-black/8 shadow-[0_30px_60px_-20px_rgba(0,0,0,0.3)] dark:ring-white/10 dark:shadow-[0_30px_60px_-20px_rgba(0,0,0,0.8)]',
    className,
  ]}
/>
